# Copiar a .env y ajustar los valores.

# Base de datos SQLite local (obligatoria).
DATABASE_URL=sqlite://data/concentrador.db

# Servidor externo al que se reenvían los registros (obligatoria).
UPSTREAM_URL=http://192.168.50.10:3000

# Timeout del reenvío en segundos (opcional, por defecto 10).
UPSTREAM_TIMEOUT_SECS=10

# Dirección de escucha (opcional, por defecto 0.0.0.0:3000).
BIND_ADDR=0.0.0.0:3000
